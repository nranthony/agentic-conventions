# Machine-local, never committed (ADR-0017): covers AGENTS.local.md at any depth,
# .claude/settings.local.json and .sandbox-repo.local; examples stay committable
*.local
*.local.*
!*.local.example*
# Project virtualenvs, whatever the environment named them (ADR-0017)
.venv*/
# Ephemeral paste-in material for agents to distill, then delete
inbox/
# Tool snapshot caches — regenerable, and may carry customer-identifying names
# (e.g. .cache/myclickup/ holds ClickUp space and list titles)
.cache/
# Local pointer to the sandbox repo checkout, read by 'just check-vendored'
.sandbox-repo.local
# Native plan-mode drafts (plansDirectory) — durable plans get promoted to work/NNNN-slug/
work/plans/
.DS_Store
